# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# STAFF_API_KEY: Legacy staff token (replaced by individual email-based staff authentication).
STAFF_API_KEY=""

# WHATSAPP_WEBHOOK_SECRET: Required header X-Webhook-Secret for inbound CRM webhooks at POST /api/webhook/whatsapp.
WHATSAPP_WEBHOOK_SECRET=""

# APPS_SCRIPT_WEB_APP_URL: The deployed Google Apps Script Web App URL receiving POST envelopes.
APPS_SCRIPT_WEB_APP_URL=""

# APPS_SCRIPT_READ_SECRET: Secret token sent by Express in POST envelopes for reading sheet data.
APPS_SCRIPT_READ_SECRET=""

# APPS_SCRIPT_WRITE_SECRET: Secret token sent by Express in POST envelopes for writing/updating sheet data.
APPS_SCRIPT_WRITE_SECRET=""

# SPREADSHEET_ID: Target Google Sheet ID.
SPREADSHEET_ID=""

# ADMIN_SETUP_EMAIL: Designated email address for the first Administrator account.
ADMIN_SETUP_EMAIL="admin@djoyplus.com"

# Email Delivery Configuration (Transactional Email Provider / SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="D' Joy Plus <noreply@djoyplus.com>"
