# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STAFF_API_KEY: Required header X-Staff-Token for staff-protected endpoints.
STAFF_API_KEY="my_secure_staff_token"

# WHATSAPP_WEBHOOK_SECRET: Secret token required for verifying live WhatsApp webhooks.
WHATSAPP_WEBHOOK_SECRET="my_whatsapp_webhook_secret"

# SPREADSHEET_ID: Target Google Sheet ID for Apps Script deployment.
SPREADSHEET_ID="your_google_sheet_id_here"

